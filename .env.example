# 官方 API 配置（支持 tools）
OFFICIAL_API_URL=https://api.anthropic.com/v1/messages
OFFICIAL_API_KEY=your_official_api_key_here

# 逆向 API 配置（不支持 tools）
REVERSE_API_URL=https://your-reverse-api.com/v1/chat/completions
REVERSE_API_KEY=your_reverse_api_key_here
# 逆向 API 固定使用的模型名称（例如：gpt-5.2, claude-3-5-sonnet-20241022）
REVERSE_API_MODEL=gpt-5.2

# 调试模式（true/false）
DEBUG_MODE=false
